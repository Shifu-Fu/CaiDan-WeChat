# ============ 依赖与构建产物 ============
node_modules/
miniprogram_npm/
**/node_modules/
**/miniprogram_npm/
dist/
build/

# ============ 小程序工具/IDE 本地文件 ============
# 微信开发者工具本地个人配置（含本地设置，不入版本库）
**/project.private.config.json
*.log
npm-debug.log*

# ============ 系统/编辑器文件 ============
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ============ WorkBuddy 本地标记/缓存 ============
# 应用卡内部标记文件，非源码
*.genie
.workbuddy/

# ============ 环境变量/密钥（防误传）============
.env
.env.*
*.local

# ============ 临时文件 ============
*.tmp
*.temp
.github-push-tmp/

# 说明：
# - vendor/ 目录是本地化的云服务 SDK（替代 npm 构建），属于源码，务必保留
# - assets-source / assets-mini 是原始素材，按项目需要保留在版本库
