page {
  min-height: 100%;
  background: #f5f6f8;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 28rpx;
}

view, text { box-sizing: border-box; }

/* 品牌色：暖橙，食欲感 */
.brand { color: #e05a36; }

/* 顶部搜索栏 */
.searchbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
}
.searchbar .search-input {
  flex: 1;
  height: 72rpx;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}

/* 分类横向滚动 */
.category-scroll {
  white-space: nowrap;
  background: #fff;
  padding: 8rpx 16rpx 16rpx;
  border-bottom: 1rpx solid #eee;
}
.category-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  background: #f2f3f5;
  color: #555;
  font-size: 26rpx;
}
.category-chip.active {
  background: #e05a36;
  color: #fff;
}

/* 菜品网格 */
.dish-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx;
}
.dish-card {
  width: calc(50% - 12rpx);
  margin: 6rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.dish-image {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #f0f0f0;
}
.dish-body { padding: 16rpx 18rpx 20rpx; }
.dish-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #222;
  line-height: 1.3;
}
.dish-tags {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #999;
  line-height: 1.4;
  height: 28rpx;
  overflow: hidden;
}
.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.dish-price { color: #e05a36; font-size: 32rpx; font-weight: 500; }
.dish-price .unit { font-size: 22rpx; }
.dish-price .dec { font-size: 22rpx; }

/* 加减按钮 */
.stepper { display: flex; align-items: center; gap: 12rpx; }
.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
}
.step-btn.plus { background: #e05a36; color: #fff; }
.step-btn.minus { background: #f2f3f5; color: #555; }
.step-qty { min-width: 32rpx; text-align: center; font-size: 28rpx; }

/* 空态 / 加载 */
.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #999;
}
.state-icon { font-size: 80rpx; color: #d0d3d8; margin-bottom: 24rpx; }
.state-title { font-size: 30rpx; color: #666; margin-bottom: 12rpx; }
.state-desc { font-size: 24rpx; text-align: center; line-height: 1.6; }

/* 通用卡片与按钮 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.primary-btn {
  background: #e05a36;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}
.primary-btn::after { border: none; }
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
  padding: 24rpx 24rpx 8rpx;
}
.section-hint { font-size: 24rpx; color: #999; padding: 0 24rpx 12rpx; }
