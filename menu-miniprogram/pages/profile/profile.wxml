<view class="page">
  <!-- 用户信息：点头像选微信头像，点昵称填微信名 -->
  <view class="user-card">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill" />
    </button>
    <view class="user-meta">
      <input class="user-name-input" type="nickname" value="{{nickName}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" placeholder="点此填写微信名" placeholder-class="nick-ph" />
      <view class="user-sub" bindtap="onUserTap">{{loginState === 'success' ? '已登录 · 点头像可换微信头像' : (loginState === 'pending' ? '正在登录…请稍候' : '登录失败 · 点此重试')}}</view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="entry-grid">
    <view class="entry-card" bindtap="goRecognize">
      <text class="entry-icon">➕</text>
      <text class="entry-title">添加菜品到菜单</text>
      <text class="entry-desc">上传图片，自动识别并发布</text>
    </view>
    <view class="entry-card" bindtap="goIngredients">
      <text class="entry-icon">🥬</text>
      <text class="entry-title">按食材找菜</text>
      <text class="entry-desc">勾选食材，找出能做的菜</text>
    </view>
    <view class="entry-card" bindtap="goAdmin">
      <text class="entry-icon">📋</text>
      <text class="entry-title">订单管理</text>
      <text class="entry-desc">店主查看全部订单</text>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="section-title">我的订单</view>
  <view wx:if="{{loading}}" class="inline-loading">加载中…</view>
  <view wx:elif="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-head">
        <text class="order-no">订单 #{{item.id}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <view class="order-items">{{item.summary}}</view>
      <view class="order-foot">
        <text class="order-time">{{item.timeText}}</text>
        <text class="order-total">¥{{item.total}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="state-wrap small">
    <text class="state-icon">📋</text>
    <text class="state-title">还没有订单</text>
    <text class="state-desc">下过的订单会显示在这里</text>
  </view>
</view>
