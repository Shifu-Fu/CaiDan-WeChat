.page { padding-bottom: 160rpx; min-height: 100vh; }
.table-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.table-label { font-size: 27rpx; color: #555; width: 180rpx; flex: none; }
.table-input { flex: 1; font-size: 27rpx; color: #333; }

.cart-list { background: #fff; margin: 0 16rpx 16rpx; border-radius: 16rpx; padding: 0 24rpx; }
.cart-item { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.cart-item:last-child { border-bottom: none; }
.cart-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f0f0f0; }
.cart-info { flex: 1; margin-left: 20rpx; }
.cart-name { font-size: 28rpx; color: #222; }
.cart-price { color: #e05a36; font-size: 28rpx; margin-top: 12rpx; }
.cart-price .dec { font-size: 20rpx; }
.cart-item .stepper { gap: 16rpx; }
.cart-item .step-qty { min-width: 36rpx; }

.summary { background: #fff; margin: 0 16rpx; border-radius: 16rpx; padding: 24rpx; }
.sum-row { display: flex; justify-content: space-between; font-size: 27rpx; color: #666; padding: 8rpx 0; }
.sum-row.total { border-top: 1rpx solid #f0f0f0; margin-top: 12rpx; padding-top: 20rpx; color: #333; }
.total-price { color: #e05a36; font-size: 36rpx; font-weight: 500; }
.clear-row { text-align: center; color: #aaa; font-size: 24rpx; padding: 32rpx; }

.submit-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  z-index: 50;
}
.submit-info { flex: 1; }
.submit-total { color: #e05a36; font-size: 40rpx; font-weight: 500; line-height: 1; }
.submit-total .dec { font-size: 26rpx; }
.submit-count { font-size: 22rpx; color: #999; margin-top: 6rpx; }
.submit-btn {
  background: #e05a36;
  color: #fff;
  font-size: 30rpx;
  padding: 24rpx 60rpx;
  border-radius: 44rpx;
}
.submit-btn.disabled { opacity: 0.6; }

.go-menu {
  margin: 8rpx auto 0;
  background: #e05a36;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 60rpx;
  border-radius: 44rpx;
  display: inline-block;
}
