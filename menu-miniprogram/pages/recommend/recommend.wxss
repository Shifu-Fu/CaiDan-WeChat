.page { padding-bottom: 40rpx; min-height: 100vh; }
.intro { padding: 32rpx 28rpx 12rpx; }
.intro-title { font-size: 38rpx; font-weight: 500; color: #222; }
.intro-desc { font-size: 25rpx; color: #999; margin-top: 8rpx; }
.quick-title { font-size: 26rpx; color: #888; padding: 20rpx 28rpx 8rpx; }
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 24rpx 20rpx;
}
.quick-card {
  width: calc(33.33% - 12rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.quick-emoji { font-size: 44rpx; line-height: 1; }
.quick-label { font-size: 24rpx; color: #555; margin-top: 14rpx; }

.input-area {
  margin: 8rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}
.ask-input { width: 100%; font-size: 28rpx; min-height: 120rpx; color: #333; line-height: 1.6; }
.input-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.char-count { font-size: 22rpx; color: #bbb; }
.ask-btn {
  background: #e05a36;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}
.ask-btn.disabled { opacity: 0.6; }

.loading-wrap { display: flex; flex-direction: column; align-items: center; padding: 80rpx 0; }
.loading-dots text { font-size: 60rpx; color: #e05a36; animation: blink 1.2s infinite; }
.loading-dots text:nth-child(2) { animation-delay: 0.2s; }
.loading-dots text:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,60%,100% { opacity: 0.25; } 30% { opacity: 1; } }
.loading-text { font-size: 25rpx; color: #999; margin-top: 8rpx; }

.result-area { padding: 16rpx 24rpx; }
.result-text {
  background: #fdf0ec;
  color: #a33f22;
  font-size: 27rpx;
  line-height: 1.6;
  padding: 24rpx;
  border-radius: 16rpx;
}
.rec-title { font-size: 28rpx; font-weight: 500; color: #333; padding: 28rpx 4rpx 12rpx; }
.rec-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 14rpx;
  margin-bottom: 14rpx;
}
.rec-img { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f0f0f0; }
.rec-info { flex: 1; margin-left: 18rpx; }
.rec-name { font-size: 28rpx; color: #222; }
.rec-price { color: #e05a36; font-size: 26rpx; margin-top: 10rpx; }
.rec-price .dec { font-size: 20rpx; }
.rec-add {
  width: 52rpx; height: 52rpx; line-height: 48rpx; text-align: center;
  background: #e05a36; color: #fff; border-radius: 50%; font-size: 38rpx;
}
.error-tip {
  margin: 24rpx; padding: 20rpx; background: #fdecec; color: #c0392b;
  font-size: 24rpx; border-radius: 12rpx; line-height: 1.5;
}
