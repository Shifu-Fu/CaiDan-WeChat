.page { min-height: 100vh; }
.intro { padding: 32rpx 28rpx 12rpx; }
.intro-title { font-size: 38rpx; font-weight: 500; color: #222; }
.intro-desc { font-size: 25rpx; color: #999; margin-top: 8rpx; }
.inline-loading { text-align: center; color: #999; font-size: 25rpx; padding: 80rpx; }

.cat-scroll { white-space: nowrap; padding: 12rpx 16rpx 20rpx; }
.cat-chip {
  display: inline-block; padding: 14rpx 30rpx; margin: 0 8rpx;
  background: #fff; border-radius: 32rpx; color: #555; font-size: 26rpx;
}
.cat-chip.active { background: #e05a36; color: #fff; }
.cat-num { font-size: 20rpx; opacity: 0.7; margin-left: 6rpx; }

.rank-list { padding: 0 24rpx 40rpx; }
.rank-item {
  display: flex; align-items: center; background: #fff; border-radius: 14rpx;
  padding: 16rpx 20rpx; margin-bottom: 14rpx;
}
.rank-no { width: 48rpx; text-align: center; font-size: 30rpx; color: #aaa; font-weight: 500; flex: none; }
.rank-no.top { color: #e05a36; font-size: 34rpx; }
.rank-img { width: 96rpx; height: 96rpx; border-radius: 10rpx; background: #f0f0f0; flex: none; }
.rank-info { flex: 1; margin: 0 20rpx; min-width: 0; }
.rank-name { font-size: 27rpx; color: #222; margin-bottom: 12rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rank-bar-wrap { height: 12rpx; background: #f2f3f5; border-radius: 6rpx; overflow: hidden; }
.rank-bar { height: 100%; background: #e05a36; border-radius: 6rpx; }
.rank-count { font-size: 30rpx; color: #e05a36; font-weight: 500; flex: none; }
.rank-count .unit { font-size: 20rpx; font-weight: 400; margin-left: 2rpx; }

.state-wrap { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.state-icon { font-size: 80rpx; }
.state-title { font-size: 30rpx; color: #666; margin-top: 24rpx; }
.state-desc { font-size: 24rpx; color: #aaa; margin-top: 12rpx; text-align: center; }
