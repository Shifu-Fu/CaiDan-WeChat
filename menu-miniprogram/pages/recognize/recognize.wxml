<view class="page">
  <view class="intro">
    <view class="intro-title">拍照识别菜品</view>
    <view class="intro-desc">上传一张菜品照片，AI 自动识别菜名和所需食材</view>
  </view>

  <!-- 上传区 -->
  <view class="upload-box" bindtap="chooseImage" wx:if="{{!imagePath}}">
    <view class="upload-icon">＋</view>
    <view class="upload-title">点击上传菜品图片</view>
    <view class="upload-desc">建议一菜一图，识别更准确</view>
  </view>

  <view class="preview-box" wx:else>
    <image class="preview-img" src="{{previewPath}}" mode="aspectFit" />
    <view class="preview-actions">
      <view class="re-choose" bindtap="chooseImage">重新选择</view>
      <view class="matting-btn {{bgRemoved ? 'done' : ''}}" bindtap="toggleMatting">{{bgRemoved ? '✓ 已去背景（点此还原）' : '✂ 去掉背景，只留菜品'}}</view>
    </view>
    <view class="matting-tip">去背景适合白底/纯色底的菜品图；复杂场景照片可能效果有限</view>
  </view>

  <!-- 识别按钮 -->
  <view wx:if="{{imagePath}}" class="recognize-btn {{loading?'disabled':''}}" bindtap="recognize">
    {{loading ? '识别中…' : '开始识别'}}
  </view>

  <!-- 加载 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="spinner"></view>
    <text class="loading-text">正在分析图片…</text>
  </view>

  <!-- 结果 -->
  <view wx:if="{{result && !loading}}" class="result-card">
    <view class="result-head">
      <text class="result-badge">识别结果</text>
      <text class="result-conf">{{result.confidenceText}}</text>
    </view>
    <view class="field">
      <view class="field-label">菜名</view>
      <input class="field-input" value="{{result.name}}" bindinput="onNameInput" placeholder="识别出的菜名" />
    </view>
    <view class="field">
      <view class="field-label">主要食材</view>
      <input class="field-input" value="{{result.ingredients}}" bindinput="onIngInput" placeholder="如：鸡蛋、西红柿" />
    </view>
    <view class="field">
      <view class="field-label">分类</view>
      <input class="field-input" value="{{result.category}}" bindinput="onCatInput" placeholder="如：热菜" />
    </view>
    <view class="field">
      <view class="field-label">价格（元）</view>
      <input class="field-input" type="number" value="{{result.price}}" bindinput="onPriceInput" placeholder="如：28" />
    </view>
    <view class="result-note">食材由 AI 根据菜名推断，仅供参考。发布后会出现在点菜菜单里。</view>
    <view class="save-btn" bindtap="saveDish">发布到点菜菜单</view>
  </view>

  <view wx:if="{{errorMsg}}" class="error-tip">{{errorMsg}}</view>

  <!-- 说明 -->
  <view class="tips-card">
    <view class="tips-title">关于这个功能</view>
    <view class="tips-text">• 上传单张菜品图，AI 识别菜名与食材</view>
    <view class="tips-text">• 整桌合照里的每道菜自动截取，目前还做不到稳定全自动</view>
    <view class="tips-text">• 素材包里 192 道菜已裁好图，可直接点菜使用</view>
  </view>
</view>
