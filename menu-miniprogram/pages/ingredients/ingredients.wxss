.page { padding-bottom: 40rpx; min-height: 100vh; }
.intro { padding: 32rpx 28rpx 16rpx; }
.intro-title { font-size: 38rpx; font-weight: 500; color: #222; }
.intro-desc { font-size: 25rpx; color: #999; margin-top: 8rpx; }
.search-icon { font-size: 38rpx; color: #999; margin-right: 12rpx; line-height: 1; }

.selected-bar {
  margin: 16rpx 24rpx 0;
  padding: 20rpx;
  background: #fdf0ec;
  border-radius: 16rpx;
}
.selected-label { font-size: 24rpx; color: #e05a36; margin-bottom: 12rpx; }
.selected-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.selected-tag {
  background: #e05a36;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.ing-section { background: #fff; margin: 16rpx 24rpx; border-radius: 16rpx; padding: 8rpx 8rpx 4rpx; }
.ing-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 16rpx;
}
.expand-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0 24rpx;
  border-top: 1rpx solid #f2f2f2;
  color: #e05a36;
  font-size: 26rpx;
}
.expand-btn .arrow { display: inline-block; font-size: 30rpx; line-height: 1; transition: transform 0.2s; }
.expand-btn .arrow.up { transform: rotate(180deg); }
.ing-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #fff;
  border: 1rpx solid #e8e9eb;
  color: #444;
  font-size: 27rpx;
  padding: 16rpx 26rpx;
  border-radius: 40rpx;
}
.ing-chip.selected {
  background: #e05a36;
  border-color: #e05a36;
  color: #fff;
}
.ing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e05a36;
}
.ing-chip.selected .ing-dot { background: #fff; }

.result-header { padding: 24rpx 24rpx 12rpx; }
.result-title { font-size: 30rpx; font-weight: 500; color: #222; }
.result-num { color: #e05a36; }
.result-switch { display: flex; gap: 16rpx; margin-top: 16rpx; }
.switch-label {
  font-size: 24rpx;
  color: #888;
  background: #f2f3f5;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}
.switch-label.active { background: #fdf0ec; color: #e05a36; }

.match-list { padding: 8rpx 24rpx; }
.match-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03);
}
.match-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f0f0f0; }
.match-info { flex: 1; margin-left: 20rpx; min-width: 0; }
.match-name { font-size: 29rpx; font-weight: 500; color: #222; }
.match-ing { font-size: 22rpx; color: #999; margin-top: 8rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.match-price { color: #e05a36; font-size: 28rpx; margin-top: 10rpx; }
.match-price .dec { font-size: 20rpx; }
.match-add {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: #e05a36;
  color: #fff;
  border-radius: 50%;
  font-size: 40rpx;
  margin-left: 12rpx;
}
